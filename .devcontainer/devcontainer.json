{
  "name": "beast",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteEnv": {
    "PATH": "/home/vscode/.local/share/aquaproj-aqua/bin:${containerEnv:PATH}"
  },
  "postStartCommand": "git config --global --unset url.git@github.com:.pushInsteadOf && git config --global --unset url.git@github.com:.insteadOf && aqua i -l",
  "updateRemoteUserUID": true,
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/git-lfs:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-in-docker:3": {},
    "ghcr.io/aquaproj/devcontainer-features/aqua-installer:0.1.6": {
      "aqua_version": "v2.56.7"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "terminal.integrated.shell.linux": "/bin/zsh"
      },
      "extensions": [
        "docker.docker",
        "GraphQL.vscode-graphql",
        "golang.go",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "kennylong.kubernetes-yaml-formatter",
        "remcohaszing.schemastore",
        "LawrenceGrant.cql",
        "github.vscode-github-actions",
        "capaj.graphql-codegen-vscode",
        "hashicorp.terraform",
        "fwcd.kotlin",
        "MermaidChart.vscode-mermaid-chart",
        "adpyke.vscode-sql-formatter"
      ]
    }
  }
}
